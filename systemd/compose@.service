[Unit]
Description=Compose Service for %i
Requires=docker.service
After=docker.service
BindsTo=docker.service
StartLimitBurst=5
StartLimitIntervalSec=100

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/compose.env
EnvironmentFile=-%h/.config/compose.env
EnvironmentFile=-%h/.config/docker/compose.env

# We delegate the actual docker compose execution to the 'compose' binary itself.
# The 'run-service' command handles resolving the directory structure (e.g. flat -> nested)
# and executing 'docker compose up'.
# BINARY_PATH is a placeholder replaced by install.sh.
ExecStart=BINARY_PATH run-service %i
ExecStop=BINARY_PATH stop-service %i

Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target