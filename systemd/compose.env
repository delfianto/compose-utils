# Data storage path
COMPOSE_DATA=/srv/data

# Project base path
COMPOSE_BASE=/srv/compose

# Traefik Let's Encrypt Configuration
TRAEFIK_ACME_DOMAIN=example.com
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Docker Connection
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock

# Infisical Secret Injection (optional -- if unset, Infisical is skipped)
#INFISICAL_PROJECT_ID=<your-project-id>
#INFISICAL_ENV=production
#INFISICAL_ADDRESS=https://infisical.yourdomain.com
#INFISICAL_BOOTSTRAP=db/postgres,db/valkey,infra/infisical
