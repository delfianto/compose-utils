# Global configuration for compose-utils

# Data storage path (e.g., /srv/data or $HOME/data)
COMPOSE_DATA=/srv/data

# Project base path (e.g., /srv/compose or $HOME/compose-projects)
COMPOSE_BASE=/srv/compose

# Traefik ACME (Let's Encrypt) Configuration
TRAEFIEFIK_ACME_DOMAIN=example.com
TRAEFIK_ACME_EMAIL=admin@example.com
TRAEFIK_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Docker Connection
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock
