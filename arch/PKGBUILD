pkgname=compose-utils
pkgver=0.3.1
pkgrel=2
pkgdesc='Docker Compose helper and systemd controller'
arch=('x86_64')
url='https://github.com/delfianto/compose-utils'
license=('MIT')
depends=('glibc' 'libgcc' 'docker' 'docker-compose' 'systemd')
provides=("compose-utils-bin=$pkgver-$pkgrel")
conflicts=('compose-utils-bin')
replaces=('compose-utils-bin')
options=('!strip' '!debug')
_archive="compose-utils-v$pkgver-linux-x86_64"
source=("$url/releases/download/arch-v$pkgver-$pkgrel/$_archive.tar.gz")
sha256sums=('9a9d76f9a49b76fc728ce033d133a28d4903237ca0b7105c9884b237d390e1ab')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 composectl "$pkgdir/usr/bin/composectl"
    ln -s composectl "$pkgdir/usr/bin/compose"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 compose.env "$pkgdir/usr/share/doc/$pkgname/compose.env"
    install -Dm0644 compose@.service "$pkgdir/usr/lib/systemd/user/compose@.service"
}
